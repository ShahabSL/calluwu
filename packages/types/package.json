{
  "name": "@calluwu/types",
  "version": "0.1.0",
  "description": "Versioned Calluwu platform contracts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShahabSL/calluwu.git",
