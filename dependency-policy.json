{
  "schemaVersion": 1,
  "node": {
    "tool": "pnpm",
    "version": "11.9.0",
    "command": ["licenses", "list", "--prod", "--json"],
    "fallback": {
      "trigger": "ERR_PNPM_MISSING_PACKAGE_INDEX_FILE",
      "installedCommand": ["list", "--prod", "--recursive", "--depth", "Infinity", "--json"],
      "lockfileCommand": [
        "list",
        "--prod",
        "--recursive",
        "--depth",
        "Infinity",
        "--json",
        "--lockfile-only"
      ],
      "licenseOverrides": [
        {
          "version": "0.28.1",
          "license": "MIT",
          "reason": "esbuild publishes one MIT-licensed optional binary package per target; pnpm leaves non-host target manifests unlinked while retaining every target in the frozen production graph.",
          "packages": [
            "@esbuild/aix-ppc64",
            "@esbuild/android-arm",
            "@esbuild/android-arm64",
            "@esbuild/android-x64",
            "@esbuild/darwin-arm64",
            "@esbuild/darwin-x64",
            "@esbuild/freebsd-arm64",
            "@esbuild/freebsd-x64",
            "@esbuild/linux-arm",
            "@esbuild/linux-arm64",
            "@esbuild/linux-ia32",
            "@esbuild/linux-loong64",
            "@esbuild/linux-mips64el",
            "@esbuild/linux-ppc64",
            "@esbuild/linux-riscv64",
            "@esbuild/linux-s390x",
            "@esbuild/linux-x64",
            "@esbuild/netbsd-arm64",
            "@esbuild/netbsd-x64",
            "@esbuild/openbsd-arm64",
            "@esbuild/openbsd-x64",
            "@esbuild/openharmony-arm64",
            "@esbuild/sunos-x64",
            "@esbuild/win32-arm64",
            "@esbuild/win32-ia32",
            "@esbuild/win32-x64"
          ]
        }
      ]
    },
    "allowedLicenses": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC0-1.0",
      "CDLA-Permissive-2.0",
      "ISC",
      "MIT",
      "MIT-0",
      "OFL-1.1",
      "OpenSSL",
      "Unicode-3.0",
      "Unlicense",
      "Zlib"
    ],
    "allowedExceptions": ["LLVM-exception"]
  },
  "rust": {
    "tool": "cargo-deny",
    "version": "0.19.4",
    "config": "deny.toml",
    "allowedLicenses": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC0-1.0",
      "CDLA-Permissive-2.0",
      "ISC",
      "MIT",
      "MIT-0",
      "OFL-1.1",
      "OpenSSL",
      "Unicode-3.0",
      "Unlicense",
      "Zlib"
    ],
    "allowedExceptions": ["LLVM-exception"]
  },
  "sbom": {
    "tool": "trivy",
    "version": "0.72.0",
    "format": "cyclonedx-json",
    "artifactDirectory": "artifacts"
  }
}
